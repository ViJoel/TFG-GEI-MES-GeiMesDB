{
    "python.testing.pytestArgs": [
        "--cov=src",
        "--cov-branch",
        "--cov-report=xml",
        "--cov-report=html",
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "never"
        }
    },
    "isort.args": [
        "--profile",
        "black",
        "--force-grid-wrap",
        "2",
        "--multi-line",
        "3",
        "--trailing-comma",
        "--indent",
        "    "
    ]
}
